{
  "name": "api",
  "version": "1.10.0",
  "description": "Main API for Curve",
  "main": "index.js",
  "scripts": {
    "audit": "npm audit --omit=dev",
    "start": "nodemon index.js --ignore ./tmp/",
    "sales:ftp": "node --inspect processes/ftpIngestion/ftpRunner.js",
    "install:ingestion": "npm ci --omit=dev --ignore-scripts",
    "trace": "node --trace-warnings  index.js",
    "debug": "node --inspect index.js",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "lint:fix": "eslint . --quiet --fix",
    "coverage": "jest --coverageReporters=text",
    "test": "npm run test:jest && npm run test:mocha",
    "test:mocha:one": "mocha",
    "test:file": "mocha 'test/integration/models/paymentGroup.integration.test.js'",
    "watch:test:file": "nodemon --ignore ./tmp/ --exec mocha --retries 0 -R min  test/integration/libs/imports/releases.integration.test.js",
    "test:mocha": "mocha \"./test/**/*.test.js\"",
    "test:unit": "mocha './test/unit/**/*.test.js'",
    "test:unit:libs": "mocha './test/unit/libs/**/*.test.js'",
    "test:unit:models": "mocha './test/unit/models/**/*.test.js'",
    "test:unit:controllers": "mocha './test/unit/controllers/**/*.test.js'",
    "test:int": "mocha './test/integration/**/*.test.js'",
    "test:int:libs": "mocha './test/integration/libs/**/*.test.js'",
    "test:int:routes": "mocha './test/integration/routes/*.test.js'",
    "test:int:processes": "mocha './test/integration/processes/**/*.test.js'",
    "test:int:controllers": "mocha './test/integration/controllers/**/*.test.js'",
    "hook:commit": "npm run lint && npm run test:unit",
    "hook:merge": "npm run lint && npm run coverage && npm run doc",
    "clean:staging:clients": "node --max-old-space-size=16384 processes/stagingDbCleanUp/cleanUpRunner.js",
    "prepare": "husky",
    "env:refresh": "node ./env/updateEnvFile.js",
    "test:jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npm run test:jest:unit && npm run test:jest:int",
    "test:jest:unit": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" BYPASS_TEST_DB=true jest --testRegex='.*\\.unit\\.test\\.js$' --no-cache --workerIdleMemoryLimit=1GB",
    "test:jest:int:ci": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --testRegex='.*\\.integration\\.test\\.js$' --no-cache --workerIdleMemoryLimit=1GB",
    "test:jest:int": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --testRegex='.*\\.integration\\.test\\.js$' --no-cache --maxWorkers=50% --logHeapUsage --workerIdleMemoryLimit=1GB",
    "debug:sheerworks": "node --max-old-space-size=16384 sandbox/catalogue/sheerWorksIngestion.js"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.10.0"
  },
  "packageManager": "npm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurveRoyalties/api.git"
  },
  "author": "Curve Royalty Systems <tom@curveroyaltysystems.com>",
  "license": "UNLICENSED",
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.0.5",
    "testcontainers": "12.0.1",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "3.1063.0",
    "@aws-sdk/client-batch": "3.1063.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1063.0",
    "@aws-sdk/client-ec2": "3.1063.0",
    "@aws-sdk/client-ecs": "3.1063.0",
    "@aws-sdk/client-lambda": "3.1063.0",
    "@aws-sdk/client-s3": "3.1063.0",
    "@aws-sdk/client-sfn": "3.1063.0",
    "@aws-sdk/client-sqs": "3.1063.0",
    "@aws-sdk/lib-storage": "3.1063.0",
    "@curveroyaltysystems/curve-env-var-resolver": "1.4.7",
    "@curveroyaltysystems/curve-shared-logic": "3.3.12",
    "@curveroyaltysystems/models": "4.0.22",
    "@curveroyaltysystems/platform-shared-utils": "10.0.1",
    "@google-cloud/bigquery": "8.3.1",
    "@google-cloud/bigquery-data-transfer": "5.1.3",
    "@google-cloud/storage": "7.21.0",
    "@node-saml/passport-saml": "5.1.0",
    "@sendgrid/mail": "8.1.6",
    "@slack/web-api": "7.16.0",
    "adm-zip": "0.5.17",
    "app-root-dir": "1.0.2",
    "archiver": "5.3.2",
    "async": "3.2.6",
