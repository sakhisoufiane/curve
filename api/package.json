  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "chai": "4.5.0",
    "chai-http": "4.4.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "28.14.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "level": "10.0.0",
    "mocha": "11.7.6",
    "mongodb-memory-server": "11.2.0",
    "node-xlsx": "0.24.0",
    "rewire": "6.0.0",
    "rimraf": "6.1.3",
    "sinon": "21.1.2",
    "sinon-chai": "3.7.0",
    "supertest": "7.2.2"
  }
}
