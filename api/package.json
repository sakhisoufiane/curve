    "currency-symbol-map": "5.1.0",
    "dateformat": "5.0.3",
    "decompress": "4.2.1",
    "dotenv": "16.6.1",
    "excel-date-to-js": "1.1.5",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "fast-json-patch": "3.1.1",
    "fix-utf8": "1.2.1",
    "ftp": "0.3.10",
    "ftps": "1.2.0",
    "gunzip-stream": "1.0.1",
    "helmet": "5.1.1",
    "humps": "2.0.1",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "9.0.3",
    "line-reader": "0.4.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "mongodb": "6.21.0",
    "mongoose-paginate-v2": "1.9.4",
    "multer": "2.2.0",
    "node-cron": "4.2.1",
    "node-schedule": "2.1.1",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "pdfkit": "0.19.1",
    "qrcode": "1.5.4",
    "redis": "4.7.1",
    "sanitize-filename": "1.6.4",
    "sqlite3": "6.0.1",
    "ssh2-sftp-client": "7.2.3",
    "stripe": "9.16.0",
    "swagger-jsdoc": "6.3.0",
    "unzipper": "0.12.3",
    "util": "0.12.5",
    "uuid": "11.1.1",
    "xlsx-populate": "1.21.0",
