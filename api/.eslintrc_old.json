{
  "env":
  {
    "browser": true,
    "es6": true,
    "node": true,
    "mocha": true
  },
  "extends": "eslint:recommended",
  "globals":
  {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parserOptions":
  {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "rules":
  {
    "indent": [
      "error",
      2
    ],
    "linebreak-style": [
      "error",
      "unix"
    ],
    "quotes": [
      "error",
      "double"
    ],
    "semi": [
      "error",
      "always"
    ],
    "no-console": "off",
    "eqeqeq": 2,
    "space-before-function-paren": ["error", "never"],
    "keyword-spacing": ["error", { "overrides": {
      "if": { "after": false },
      "for": { "after": false },
      "while": { "after": false },
      "catch": { "after": false },
      "switch": { "after": false }
    }}],
    "comma-spacing": ["error", { "before": false, "after": true }],
    "comma-dangle": ["error", "never"]
  }
}