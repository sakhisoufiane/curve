{
  "name": "front_end",
  "version": "1.11.0",
  "description": "Front End for Curve",
  "main": "index.js",
  "scripts": {
    "audit": "npm audit --omit=dev",
    "build": "gulp build",
    "start:quick": "nodemon index.js",
    "start:dev": "gulp build:dev && nodemon index.js",
    "start": "gulp build && node index.js",
    "serve": "concurrently -k -r  \"npm run start:dev\" \"gulp watch\"",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "lint:rule": "eslint public/angular/services/track.js --no-eslintrc --env 'es2022' --env 'node' --parser-options '{ecmaVersion: 13}' --rule 'prefer-arrow-callback: 2'",
    "env:refresh": "node ./env/updateEnvFile.js"
  },
  "engines": {
    "node": "22.14.0"
  },
  "author": "Curve Royalty Systems <tom@curveroyaltysystems.com>",
  "license": "ISC",
  "dependencies": {
    "@curveroyaltysystems/curve-env-var-resolver": "1.4.6",
    "@curveroyaltysystems/platform-shared-utils": "9.0.6",
    "@microsoft/microsoft-graph-client": "^3.0.2",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.2",
    "express": "^4.22.1",
    "express-handlebars": "^6.0.6",
    "express-session": "^1.17.3",
    "googleapis": "^109.0.1",
    "helmet": "^6.0.0",
    "http": "0.0.0",
    "moment": "^2.29.4",
    "ng-file-upload": "^12.2.13",
    "pako": "^2.0.4",
    "uuid": "^8.3.2",
    "xml2js": "^0.6.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-plugin-angularjs-annotate": "^0.10.0",
    "colorette": "^2.0.19",
    "concurrently": "^7.4.0",
    "eslint": "^8.24.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "gulp": "^5.0.1",
    "gulp-angular-order": "^1.1.0",
    "gulp-babel": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-html-minifier-terser": "^7.1.0",
    "gulp-ignore": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "postcss": "^8.5.9",
    "rev-hash": "^3.0.0",
    "through2": "^4.0.2"
  }
}
