{
  "name": "jira-stats",
  "version": "1.0.0",
  "description": "Script to fetch Jira tickets updated this month",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev:frontend": "vite",
    "dev:backend": "node server.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "docker:run": "docker run -p 3011:3000 sakhisoufiane/deployments:jira-stats",
    "docker:build": "docker build . -t sakhisoufiane/deployments:jira-stats",
    "docker:tag": "docker tag sakhisoufiane/deployments:jira-stats sakhisoufiane/deployments:jira-stats",
    "docker:push": "docker push sakhisoufiane/deployments:jira-stats",
    "docker:deploy": "npm run docker:build && npm run docker:tag && npm run docker:push"

  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.12"
  }
}
