{
  "name": "processor",
  "version": "1.10.1",
  "description": "Application for ingesting sales files, creating reports and calculating royalties",
  "main": "taskManager.js",
  "scripts": {
    "start": "node taskManager.js",
    "audit": "npm audit --omit=dev",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "coverage": "nyc --reporter=html mocha --exit './test/unit/**/*.test.js'",
    "test": "npm run test:jest && npm run test:unit && npm run test:int && npm run test:periods",
    "test:file": "mocha ./test/periods/test_files__do_not_edit/62ea648a51e56e948a21a922.integration.test.js",
    "test:unit": "mocha './test/unit/**/*.test.js'",
    "test:unit:series": "mocha --parallel false './test/unit/**/*.test.js'",
    "test:unit:libs": "mocha './test/unit/libs/**/*.test.js'",
    "test:unit:models": "mocha './test/unit/models/**/*.test.js'",
    "test:int": "mocha './test/integration/**/*.test.js'",
    "test:int:libs": "mocha './test/integration/libs/**/*.test.js'",
    "test:int:models": "mocha './test/integration/models/**/*.test.js'",
    "test:periods": "mocha test/periods/test_files__do_not_edit/*.js",
    "test:develop": "npm run test:unit && npm run test:int",
    "qa:ingest": "node --max-old-space-size=16384 ingestSalesFileById.js 643d1bc7beedf977cf9a3449",
    "qa:ingest:debug": "node --inspect --max-old-space-size=16384 ingestSalesFileById.js 620e77f38ef36316f64acc6e",
    "qa:ingest:ack": "node --max-old-space-size=16384 ingestAcknowledgementFileById.js 63e529416895395470256ce8",
    "qa:reval": "node revalidateSalesFileById.js 6132b4e8ba1a87263a290dca",
    "qa:period": "node --max-old-space-size=16384 processPeriodById.js 66f550ed50dcb276c67328dd",
    "qa:period:debug": "node --inspect --max-old-space-size=16384 processPeriodById.js 60f6ecafadfa251ffe188ce9",
    "qa:periodcanaryprod": "node --max-old-space-size=16384 processPeriodById.js 604ab54df6e8b3000ff631c6",
    "qa:state": "node --inspect --max-old-space-size=16384 processStatementById.js 670d4b2f8d93d8044381ced8",
    "qa:batch": "node --max-old-space-size=16384 processBatchTaskById.js 663b8859d5d02d3745bf2335",
    "qa:periodfiles": "node --inspect --max-old-space-size=16384 getPeriodFIlesById.js",
    "copyclient": "node --max-old-space-size=16384 copyClientById.js 62e93da450f263296e8b9add",
    "fixedReport": "node runFixedReportById.js",
    "qa": "npm run qa:ingest && npm run qa:reval && npm run qa:period",
    "hook:commit": "npm run lint && npm run test:unit",
    "hook:merge": "npm run lint && npm run coverage && npm run doc",
    "preflight": "npm run hook:merge && npm run qa",
    "link:shared": "npm link @curveroyaltysystems/platform-shared-utils",
    "recalc:filter": "node testRecalculationFilter.js 60770fe43d0226540362cc9e",
    "mocha:watch": "nodemon --ignore ./tmp/ --exec mocha --retries 0 -R min  test/unit/libs/calculation/period/periodStatementCreation.unit.test.js",
    "mocha:watch:nyc": "nodemon --ignore ./tmp/ --exec nyc mocha --retries 0 -R min test/unit/libs/calculation/contract/separatedDeductionTerms.unit.test.js",
    "debugger": "node refactorEscalationsObject.js",
    "prepare": "husky",
    "env:refresh": "node ./env/updateEnvFile.js",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:jest:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex='.*\\.unit\\.test\\.js$'",
    "test:jest:int": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex='.*\\.integration\\.test\\.js$'"
  },
  "engines": {
    "node": "22.14.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-batch": "3.1030.0",
    "@aws-sdk/client-lambda": "3.1030.0",
    "@aws-sdk/client-s3": "3.1030.0",
    "@aws-sdk/client-sfn": "3.1030.0",
    "@aws-sdk/client-sqs": "3.1030.0",
    "@aws-sdk/lib-storage": "3.1030.0",
    "@curveroyaltysystems/bigquery": "0.0.5",
    "@curveroyaltysystems/curve-env-var-resolver": "1.4.6",
    "@curveroyaltysystems/curve-shared-logic": "3.2.0",
    "@curveroyaltysystems/logger": "2.0.1",
    "@curveroyaltysystems/models": "4.0.17",
    "@curveroyaltysystems/platform-shared-utils": "9.0.7",
    "@curveroyaltysystems/sales-calculator": "3.0.5",
    "@google-cloud/bigquery": "6.0.1",
    "@google-cloud/storage": "7.6.0",
    "@google-cloud/workflows": "3.4.0",
    "@sendgrid/mail": "8.1.1",
    "@smithy/node-http-handler": "4.0.6",
    "@types/papaparse": "5.5.0",
    "adm-zip": "0.5.16",
    "app-root-dir": "1.0.2",
    "archiver": "7.0.1",
    "async": "3.2.4",
    "avsc": "5.7.7",
    "aws-sdk": "2.1692.0",
    "axios": "1.15.0",
    "cfb": "1.2.2",
    "chardet": "1.4.0",
    "chunk": "0.0.3",
    "csv-parser": "3.2.0",
    "csv-stringify": "6.5.2",
    "csv-write-stream": "2.0.0",
    "currency-symbol-map": "5.1.0",
    "dotenv": "16.0.1",
    "exceljs": "4.3.0",
    "fast-csv": "4.3.6",
    "fix-utf8": "1.1.1",
    "ftp": "0.3.10",
    "isbinaryfile": "5.0.4",
    "level": "10.0.0",
    "lodash": "4.17.23",
    "moment": "2.29.4",
    "mongodb": "6.20.0",
    "mongoose": "8.19.1",
    "mongoose-paginate": "5.0.3",
    "papaparse": "5.5.3",
    "pdfkit": "0.13.0",
    "sanitize-filename": "1.6.3",
    "ssh2-sftp-client": "7.2.2",
    "tmp": "0.2.1",
    "util": "0.12.4",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@testcontainers/localstack": "11.14.0",
    "@types/jest": "29.5.14",
    "chai": "4.3.6",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-jest": "28.11.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "mocha": "10.0.0",
    "mongodb-memory-server": "10.1.4",
    "nyc": "15.1.0",
    "rewire": "6.0.0",
    "sinon": "21.0.1",
    "unzipper": "0.12.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurveRoyalties/processor.git"
  },
  "author": "Curve Royalty Systems <tom@curveroyaltysystems.com>",
