{
  "name": "@curveroyaltysystems/platform-shared-utils",
  "version": "9.0.7",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./libs/testUtils": "./dist/testUtils.js",
    "./libs/promisify": "./dist/promisify.js",
    "./libs/BigQuery": "./dist/bigQuery.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint \"src/**/*.[ts|js]*\"",
    "lint:quiet": "eslint \"src/**/*.[ts|js]*\" --quiet",
    "test": "jest --runInBand --no-cache",
    "test:unit": "jest --testMatch='<rootDir>/src/**/*.unit.test.{ts,js}' --runInBand --no-cache",
    "test:int": "jest --testMatch='<rootDir>/src/**/*.integration.test.{ts,js}' --runInBand --no-cache",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1030.0",
    "@aws-sdk/client-s3": "3.1030.0",
    "@aws-sdk/client-secrets-manager": "3.1030.0",
    "@aws-sdk/crc64-nvme": "3.972.6",
    "@aws-sdk/lib-storage": "3.1030.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@e965/xlsx": "0.20.3",
    "@google-cloud/bigquery": "7.9.4",
    "@google-cloud/bigquery-reservation": "4.4.0",
    "@testcontainers/gcloud": "11.14.0",
    "app-root-dir": "1.0.2",
    "archiver": "7.0.1",
    "async": "3.2.6",
    "axios": "1.15.0",
    "chardet": "1.6.0",
    "chunk": "0.0.3",
    "crypto": "1.0.1",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "fast-csv": "4.3.6",
    "fs": "0.0.1-security",
    "ftp": "0.3.10",
    "hasha": "5.2.2",
    "line-by-line": "0.1.6",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "mongodb": "6.21.0",
    "mongoose": "8.23.0",
    "mpath": "0.9.0",
    "sanitize-filename": "1.6.4",
    "sinon": "21.1.2",
    "ssh2-sftp-client": "7.2.3",
    "uuid": "11.1.0",
    "winston": "3.19.0",
    "winston-cloudwatch": "6.3.0",
    "xlsx-extract": "0.1.3",
    "xlsx-populate": "1.21.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@curveroyaltysystems/eslint-config": "*",
    "@curveroyaltysystems/prettier-config": "*",
    "@curveroyaltysystems/test-config": "*",
    "@curveroyaltysystems/typescript-config": "*",
    "@types/app-root-dir": "0.1.4",
    "chai": "4.5.0",
    "husky": "9.1.7",
    "nyc": "15.1.0",
    "rimraf": "3.0.2",
    "sinon-chai": "3.7.0",
    "@types/node": "22.19.17"
  },
  "prettier": "@curveroyaltysystems/prettier-config",
  "jest": {
    "preset": "@curveroyaltysystems/test-config",
    "globalSetup": "<rootDir>/jest.globalSetup.ts",
    "globalTeardown": "<rootDir>/jest.globalTeardown.ts",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 60000,
    "maxWorkers": 4
  }
}
