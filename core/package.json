{
  "name": "@curveroyaltysystems/core",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:nocache": "turbo build --no-cache",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && find . -name package-lock.json -type f -delete",
    "refresh": "npm run clean && npm install && npm run build",
    "dev": "turbo dev",
    "ui": "turbo dev --filter @curveroyaltysystems/curve-app --filter @curveroyaltysystems/react-ui-library --filter @curveroyaltysystems/i18n",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "typecheck:watch": "turbo typecheck:watch",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "gen:package": "sh ./scripts/generate-package.sh",
    "build:app:imports": "turbo build --filter @curveroyaltysystems/imports",
    "start:app:imports": "turbo start --filter @curveroyaltysystems/imports",
    "dev:app:curve-app": "turbo dev --filter @curveroyaltysystems/curve-app",
    "build:app:curve-app": "turbo build --filter @curveroyaltysystems/curve-app",
    "start:app:curve-app": "turbo start --filter @curveroyaltysystems/curve-app",
    "build:package:models": "turbo build --filter @curveroyaltysystems/models",
    "build:package:logger": "turbo build --filter @curveroyaltysystems/logger",
    "build:package:platform-shared-utils": "turbo build --filter @curveroyaltysystems/platform-shared-utils",
    "build:package:curve-shared-logic": "turbo build --filter @curveroyaltysystems/curve-shared-logic"
  },
  "devDependencies": {
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "2.9.6"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.10.0"
  },
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.27.2",
    "@rollup/rollup-linux-x64-gnu": "4.57.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.18",
    "lightningcss-linux-x64-gnu": "1.30.2",
    "@turbo/linux-64": "2.9.6"
  }
}
