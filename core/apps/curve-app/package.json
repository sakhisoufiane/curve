{
  "name": "@curveroyaltysystems/curve-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "turbo build --filter @curveroyaltysystems/curve-app^...",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint \"src/**/*.[ts|js]*\"",
    "lint:quiet": "eslint \"src/**/*.[ts|js]*\" --quiet",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@curveroyaltysystems/i18n": "*",
    "@curveroyaltysystems/react-ui-library": "*",
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "5.99.0",
    "axios": "1.15.0",
    "dompurify": "3.4.2",
    "framer-motion": "12.38.0",
    "react": "19.1.0",
    "react-cookie": "8.1.0",
    "react-dom": "19.1.0",
    "react-google-recaptcha": "3.1.0",
    "react-router-dom": "7.14.1",
    "tailwindcss": "4.2.2",
    "zod": "4.1.11",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@curveroyaltysystems/eslint-config": "*",
    "@curveroyaltysystems/prettier-config": "*",
    "@curveroyaltysystems/typescript-config": "*",
    "@types/dompurify": "3.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-google-recaptcha": "2.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "prettier": "3.8.3",
    "vite": "7.3.2"
  },
  "prettier": "@curveroyaltysystems/prettier-config"
}
