{
  "name": "@curveroyaltysystems/sales-calculator",
  "version": "3.0.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cdk-app": "infra/bin/cdk-app.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "qa:calculation": "node src/sandbox/runSalesCalculation.js",
    "qa:runTaskLocally": "node src/sandbox/runTaskLocally.js",
    "clients:set-feature-flag": "node src/sandbox/updateFeatureFlag.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "cdk": "cdk",
    "synth:infra": "npm run build && cdk synth",
    "deploy:infra": "npm run build && cdk deploy --require-approval never",
    "destroy:infra": "npm run build && cdk destroy --force",
    "deploy:docker": "(cd ../../ && bash apps/sales-calculator/infra/scripts/deploy-docker.sh)"
  },
  "devDependencies": {
    "@curveroyaltysystems/eslint-config": "*",
    "@curveroyaltysystems/prettier-config": "*",
    "@curveroyaltysystems/typescript-config": "*",
    "@types/async": "3.2.25",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/moment": "2.13.0",
    "@types/node": "22.19.17",
    "jest": "29.7.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "3.1030.0",
    "@aws-sdk/client-lambda": "3.1030.0",
    "@aws-sdk/client-ssm": "3.1030.0",
    "@curveroyaltysystems/aws-base-infra": "2.0.0",
    "@curveroyaltysystems/models": "*",
    "@curveroyaltysystems/platform-shared-utils": "*",
    "@google-cloud/storage": "7.19.0",
    "app-root-dir": "1.0.2",
    "async": "3.2.6",
    "aws-cdk": "2.1118.3",
    "aws-cdk-lib": "2.254.0",
    "constructs": "10.6.0",
    "dotenv": "16.6.1",
    "level": "10.0.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "mongodb": "6.21.0",
    "ts-node": "10.9.2"
  },
  "prettier": "@curveroyaltysystems/prettier-config"
}
