{
  "name": "@curveroyaltysystems/catalogue-io",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "qa:runWorksExport": "tsx src/sandbox/works/runExportTaskLocally.js",
    "qa:runWorksImport": "tsx --max-old-space-size=12000 src/sandbox/works/runImportTaskLocally.js"
  },
  "devDependencies": {
    "@curveroyaltysystems/eslint-config": "*",
    "@curveroyaltysystems/prettier-config": "*",
    "@curveroyaltysystems/test-config": "*",
    "@curveroyaltysystems/typescript-config": "*",
    "@types/archiver": "^6.0.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.14.0",
    "@types/node": "^22.14.0",
    "typescript": "^5.0.0",
    "excel-date-to-js": "^1.1.4"
  },
  "dependencies": {
    "@curveroyaltysystems/curve-shared-logic": "*",
    "@curveroyaltysystems/models": "*",
    "@curveroyaltysystems/platform-shared-utils": "*",
    "app-root-dir": "^1.0.2",
    "@sendgrid/mail": "^8.0.0",
    "archiver": "^7.0.0",
    "csv-stringify": "^6.0.0",
    "dotenv": "^16.0.1",
    "fix-utf8": "^1.1.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4"
  },
  "jest": {
    "preset": "@curveroyaltysystems/test-config"
  },
  "prettier": "@curveroyaltysystems/prettier-config"
}
